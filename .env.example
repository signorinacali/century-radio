# Environment Configuration Template
# Copy to .env and adjust local values:
#   cp .env.example .env

APP_ENV=development
PORT=3000
DEBUG=true

# Phase 2: Historical Script Generation & TTS
# DeepSeek-V4.1-Flash (`deepseek-flash`) runs as primary by default;
# set LLM_PRIMARY_PROVIDER=gemini once GEMINI_API_KEY has active credits.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_PRIMARY_PROVIDER=deepseek
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Optional: Vercel Blob storage & Cron protection in production
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
